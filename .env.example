# TrueForge (local: npx → :8790, docker compose in infra/ → :8791)
TRUEFORGE_API_KEY=
TRUEFORGE_BASE_URL=http://localhost:8791

# Keyring Postgres (infra service keyring-db on host port 5432)
DATABASE_URL=postgresql://keyring:keyring@localhost:5432/keyring

# Server
PORT=3001
HOST=0.0.0.0

# Checkpoint 7 — stub model + agent registration (free fixture path)
# KEYRING_STUB_MODEL_PORT=4099
# KEYRING_STUB_MODEL_URL=http://host.docker.internal:4099/v1
# KEYRING_BASE_URL=http://localhost:3001
# KEYRING_MCP_PUBLIC_URL=http://host.docker.internal:3001
# KEYRING_SCAN_DELAY_MS=1000
# KEYRING_EXPORT_SECRET=change-me-for-signed-audit-exports
# KEYRING_SCAN_DRIVER=fixture

# Checkpoint 11 — execute / revoke (dry-run ON by default — safe for judges)
# KEYRING_EXECUTE_DRY_RUN=1
# KEYRING_REVOKE_BACKEND=fixture
# Live revoke (explicit): KEYRING_EXECUTE_DRY_RUN=0 KEYRING_REVOKE_BACKEND=live
# GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
# GOOGLE_WORKSPACE_MCP_URL=
# GOOGLE_ORG_DOMAIN=keyring-test.example

# Checkpoint 12 — policy + scheduled re-audit
# KEYRING_POLICY_PATH=./keyring.yml
# KEYRING_REAUDIT_CRON=0 6 * * *
# KEYRING_REAUDIT_PERSON=scheduled-reaudit

# Checkpoint 10 — real models, caps, record/replay (keys never committed)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# KEYRING_HARD_CAP_USD=0.50
# KEYRING_MODEL_INVENTORY=openai/gpt-4o-mini
# KEYRING_MODEL_REASONING=openai/gpt-4o
# KEYRING_SCAN_DRIVER=record
# VITE_SCAN_DRIVER=replay
# KEYRING_RECORDING_ID=ada-lovelace
# KEYRING_ALLOW_STUB=0

# Web
VITE_API_BASE_URL=http://localhost:3001

# --- Test org seed (optional live overlay; never commit real values) ---
SEED_LIVE=false
KEYRING_TEST_ORG_NAME=keyring-test
GITHUB_TOKEN=
GITHUB_ORG=
SLACK_BOT_TOKEN=
GOOGLE_ACCESS_TOKEN=
# Optional identity overrides (defaults are in scripts/test-org/dataset.ts)
# KEYRING_TEST_ADA_WORK_EMAIL=
# KEYRING_TEST_ADA_PERSONAL_EMAIL=
# KEYRING_TEST_ADA_GITHUB_USERNAME=
# KEYRING_TEST_GRACE_WORK_EMAIL=
# KEYRING_TEST_ALAN_WORK_EMAIL=

# Live connector integration tests (opt-in; skipped in CI by default)
# LIVE_CONNECTORS=false
# GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
# GOOGLE_WORKSPACE_MCP_URL=
# GOOGLE_ORG_DOMAIN=keyring-test.example
