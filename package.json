{
  "name": "keyring",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "demo": "tsx scripts/demo.ts",
    "dev": "pnpm --parallel --filter @keyring/server --filter @keyring/web dev",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @keyring/server db:migrate",
    "seed:test-org": "tsx scripts/seed-test-org.ts",
    "teardown:test-org": "tsx scripts/teardown-test-org.ts",
    "reconcile": "node packages/core/dist/identity/cli.js",
    "stub:model": "tsx scripts/stub-model-server.ts",
    "register:agent": "tsx scripts/register-keyring-agent.ts",
    "demo:reconnect": "tsx scripts/demo-reconnect-scan.ts",
    "record:scan": "tsx scripts/record-scan.ts",
    "verify:audit": "tsx scripts/verify-audit.ts",
    "audit:secrets": "tsx scripts/audit-secrets.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
