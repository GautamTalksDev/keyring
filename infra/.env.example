# Local-dev credentials only. Change every value for a shared or networked host.
# Copy to .env before `docker compose up`.

KEYRING_POSTGRES_USER=keyring
KEYRING_POSTGRES_PASSWORD=replace-with-a-long-random-password
KEYRING_POSTGRES_DB=keyring

POSTGRES_USER=trueforge
POSTGRES_PASSWORD=replace-with-a-different-long-random-password
POSTGRES_DB=trueforge

# npm version baked into Dockerfile.trueforge (override via compose build-arg).
TRUEFORGE_VERSION=0.1.4
